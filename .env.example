# OpenContentAI - exemple de configuration locale
# Copier ce fichier vers .env sur la machine de travail.
# Ne jamais publier le fichier .env réel.

# n8n : port local de l'interface web
N8N_PORT=5678
GENERIC_TIMEZONE=Africa/Dakar

# Laisser vide en usage local.
# Un webhook Telegram nécessitera plus tard une URL HTTPS accessible publiquement.
# Cette valeur doit rester dans .env et ne doit jamais être commitée.
WEBHOOK_URL=

# Dossier de médias suggéré pour les futurs scripts.
# Cette variable n'est pas encore consommée par le fichier Compose.
CONTENT_ROOT=C:/OpenContentAI-Data
